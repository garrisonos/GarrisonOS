{
  "name": "garrison-os",
  "version": "0.1.0-dev",
  "description": "Zero-dependency, open-source property management platform",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "setup": "node scripts/setup.js",
    "start": "node scripts/serve.js",
    "start:community": "node scripts/serve.js --edition=community",
    "start:engine": "node dist/api/server.js",
    "dev": "node scripts/serve.js --dev",
    "dev:engine": "node --watch dist/api/server.js",
    "migrate": "node dist/database/migrator.js",
    "seed": "node dist/database/seed.js",
    "check:hygiene": "node scripts/check-hygiene.js",
    "check:security": "node scripts/check-security.js",
    "check": "node scripts/check-hygiene.js && node scripts/check-security.js",
    "test": "node scripts/test.js",
    "test:core": "node scripts/test.js core",
    "test:module": "node scripts/test.js",
    "package:community": "node scripts/package-community.js",
    "package:standard": "node scripts/package-standard.js"
  },
  "keywords": [
    "property-management",
    "real-estate",
    "landlord",
    "accounting",
    "zero-dependency",
    "multi-tenant"
  ],
  "author": "GarrisonOS Contributors",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.8.0"
  }
}
